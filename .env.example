# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit ไฟล์ .env)

# Supabase > Connect > Session pooler
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# (แนะนำ) ใบรับรอง CA ของ Supabase: Project Settings > Database > SSL Configuration > Download certificate
# DATABASE_CA_CERT=./certs/prod-ca-2021.crt

# PORT=3000
