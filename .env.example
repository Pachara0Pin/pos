# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit ไฟล์ .env) — ใช้กับสคริปต์ใน scripts/ เท่านั้น
# หน้าเว็บไม่ได้ใช้ไฟล์นี้ (หน้าเว็บอ่านค่าจาก public/config.js)

# Supabase > Connect > Session pooler
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# สำหรับ scripts/migrate-users.js (Project Settings > API Keys) — เป็นความลับ
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# สำหรับ deploy Edge Function (Account > Access Tokens) — เป็นความลับ ลบทิ้งได้หลัง deploy
SUPABASE_ACCESS_TOKEN=
